{
  "name": "dsh-gongwei",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Workday check-in, daily study log, a wishlist of things to learn, weekly report and persistent memory, surfaced through the dsh-pet desktop pet.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-pet",
    "check-in",
    "habit-tracker",
    "journal",
    "weekly-report"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node smoke.mjs",
    "test:im": "node --test im-notifier.test.mjs"
  },
  "files": [
    "index.js",
    "im-notifier.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "tools",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
